# =============================================================
# MAX Comments Platform — Шаблон переменных окружения
# Скопируй в infra/.env и заполни реальными значениями
# НЕ КОММИТЬ infra/.env в git!
# =============================================================

# --- MAX БОТ ---
# Получить на business.max.ru (сначала тестовый, потом боевой)
MAX_BOT_TOKEN=your_test_token_here

# HTTPS URL куда MAX шлёт webhook-события
# Формат: https://ВАШ_ДОМЕН_ИЛИ_IP:ПОРТ/webhook
WEBHOOK_URL=https://YOUR_DOMAIN_OR_IP:8443/webhook

# 32 случайных символа для верификации webhook-запросов
WEBHOOK_SECRET=generate_32_random_chars_here

# --- БАЗА ДАННЫХ (изолированный контейнер mc_postgres) ---
DB_NAME=maxcomments
DB_USER=mcuser
DB_PASSWORD=strong_random_password_here
# Используется внутри Docker-сети (не менять хост mc_postgres)
DATABASE_URL=postgresql://mcuser:strong_random_password_here@mc_postgres:5432/maxcomments

# --- REDIS (изолированный контейнер mc_redis) ---
REDIS_PASSWORD=another_strong_password_here
# Используется внутри Docker-сети (не менять хост mc_redis)
REDIS_URL=redis://:another_strong_password_here@mc_redis:6379

# --- MINI APP ---
# Mini App раздаётся nginx с того же домена (собирается в Dockerfile.nginx)
MINI_APP_URL=https://sushi-house-39.online

# --- NGINX ПОРТЫ ---
# Уточнить у владельца какие порты свободны на VPS!
# Нельзя использовать 80/443 — там могут быть другие сервисы
NGINX_HTTP_PORT=8080
NGINX_HTTPS_PORT=8443

# --- ПЛАТЕЖИ ЮКАССА ---
# Заполнить когда аккаунт ЮКасса готов
# Для тестов использовать sandbox-магазин
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET=

# --- НАСТРОЙКИ ПРИЛОЖЕНИЯ ---
NODE_ENV=production
BOT_PORT=3000
BACKEND_PORT=3001

# Стоимость PRO подписки в рублях
PRO_PRICE_RUB=299
# Длительность PRO подписки в днях
PRO_DURATION_DAYS=30
